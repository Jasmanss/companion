{
  "name": "steward",
  "productName": "Steward",
  "version": "0.1.0",
  "description": "A desktop assistant that lives at the edge of your screen while you code",
  "main": "./out/main/index.js",
  "author": "Jasman Sidhu",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jasmanss/companion.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "design": "node scripts/design-server.mjs",
    "pack": "electron-vite build && electron-builder --mac --dir",
    "dist": "electron-vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zod": "^4.6.6"
  }
}
